{
  "version": 1,
  "name": "teleop with telemetry",
  "broadcast": "robot-01",
  "grid": { "cols": 12, "row_height": 40 },
  "widgets": [
    { "id": "front", "type": "video", "at": [0, 0, 6, 9], "bind": { "track": "front" } },
    { "id": "rear", "type": "video", "at": [6, 0, 6, 9], "bind": { "track": "rear" }, "props": { "hud": "compact" } },
    { "id": "lock", "type": "lock", "at": [0, 9, 3, 3], "bind": { "lock": "drive" }, "pinned": true },
    { "id": "drive", "type": "drive", "at": [3, 9, 3, 5], "bind": { "channel": "drive", "lock": "drive" }, "props": { "rate_hz": 20 } },
    { "id": "status", "type": "status", "at": [6, 9, 3, 5] },
    { "id": "battery", "type": "number", "at": [9, 9, 3, 2], "bind": { "track": "telemetry", "path": "battery_v" }, "props": { "label": "Battery", "digits": 2 } },
    { "id": "lights", "type": "toggle", "at": [9, 11, 3, 2], "bind": { "channel": "lights", "track": "telemetry", "path": "lights.on" }, "props": { "label": "Lights" } },
    { "id": "lights-off", "type": "button", "at": [0, 12, 3, 2], "bind": { "channel": "lights" }, "props": { "label": "All lights off", "message": { "on": false } } },
    { "id": "speed", "type": "plot", "at": [0, 14, 6, 4], "bind": { "track": "telemetry", "path": "speed" }, "props": { "label": "Speed (m/s)", "window_s": 20, "min": -2, "max": 2 } },
    { "id": "telemetry", "type": "values", "at": [6, 14, 3, 4], "bind": { "track": "telemetry" } },
    { "id": "latency", "type": "latency", "at": [9, 13, 3, 5], "bind": { "track": "front" } },
    { "id": "log", "type": "log", "at": [0, 18, 12, 4] }
  ]
}
