<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd daemon for tq-publisher on macOS, installed by install.sh into
     /Library/LaunchDaemons. launchd has no environment file, so a shell
     reads /etc/tq/publisher.env first. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.tq.publisher</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; [ -f /etc/tq/publisher.env ] &amp;&amp; . /etc/tq/publisher.env; exec /usr/local/bin/tq-publisher --config /etc/tq/publisher.json</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>2</integer>
  <key>StandardOutPath</key>
  <string>/var/log/tq-publisher.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/tq-publisher.log</string>
</dict>
</plist>
